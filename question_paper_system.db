 5indexidx_questions_lookupquestionsCREATE INDEX idx_questions_lookup ON questions(subject_id, status, marks)ƒ>	 55†tablequestion_usage_auditquestion_usage_audit
CREATE TABLE question_usage_audit (
        audit_id INTEGER PRIMARY KEY AUTOINCREMENT,
        question_id INTEGER NOT NULL,
        paper_id INTEGER NOT NULL,
        used_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY (question_id) REFERENCES questions(question_id) ON DELETE CASCADE,
        FOREIGN KEY (paper_id) REFERENCES generated_papers(paper_id) ON DELETE CASCADE
    )ƒi ++‡	tablepaper_questionspaper_questions	CREATE TABLE paper_questions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        paper_id INTEGER NOT NULL,
        question_id INTEGER NOT NULL,
        section_name VARCHAR(50) NOT NULL,
        question_order INTEGER NOT NULL,
        marks INTEGER NOT NULL,
        FOREIGN KEY (paper_id) REFERENCES generated_papers(paper_id) ON DELETE CASCADE,
        FOREIGN KEY (question_id) REFERENCES questions(question_id) ON DELETE RESTRICT
    )…v  --‹tablegenerated_papersgenerated_papersCREATE TABLE generated_papers (
        paper_id INTEGER PRIMARY KEY AUTOINCREMENT,
        paper_title VARCHAR(150) NOT NULL,
        subject_id INTEGER NOT NULL,
        exam_code VARCHAR(50),
        duration_minutes INTEGER NOT NULL DEFAULT 180,
        total_marks INTEGER NOT NULL CHECK (total_marks > 0),
        academic_year VARCHAR(30) NOT NULL DEFAULT '2026-2027',
        semester INTEGER NOT NULL,
        blueprint_json TEXT NOT NULL,
        pdf_path VARCHAR(255),
        generated_by INTEGER NOT NULL,
        generated_by_name VARCHAR(120) NOT NULL,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY (subject_id) REFERENCES subjects(subject_id) ON DELETE RESTRICT
    )ˆ {tablequestionsquestions CREATE TABLE questions (
        question_id INTEGER PRIMARY KEY AUTOINCREMENT,
        subject_id INTEGER NOT NULL,
        unit_id INTEGER NOT NULL,
        faculty_id INTEGER NOT NULL,
        faculty_name VARCHAR(120) NOT NULL,
        question_text TEXT NOT NULL,
        marks INTEGER NOT NULL CHECK (marks > 0),
        difficulty VARCHAR(20) NOT NULL CHECK (difficulty IN ('Easy', 'Medium', 'Hard')),
        blooms_level VARCHAR(30) NOT NULL CHECK (blooms_level IN ('Remember', 'Understand', 'Apply', 'Analyze', 'Evaluate', 'Create')),
        status VARCHAR(20) NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'APPROVED', 'REJECTED')),
        rejection_reason TEXT,
        approved_by INTEGER,
        usage_count INTEGER NOT NULL DEFAULT 0,
        last_used_at TIMESTAMP,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY (subject_id) REFERENCES subjects(subject_id) ON DELETE RESTRICT,
        FOREIGN KEY (unit_id) REFERENCES units(unit_id) ON DELETE RESTRICT
    )‚U …	tableunitsunitsCREATE TABLE units (
        unit_id INTEGER PRIMARY KEY AUTOINCREMENT,
        subject_id INTEGER NOT NULL,
        unit_number INTEGER NOT NULL,
        unit_name VARCHAR(150) NOT NULL,
        FOREIGN KEY (subject_id) REFERENCES subjects(subject_id) ON DELETE CASCADE,
        UNIQUE (subject_id, unit_number)
    ))= indexsqlite_autoindex_units_1unitsP++Ytablesqlite_sequencesqlite_sequenceCREATE TABLE sqlite_sequence(name,seq)‚r …7tablesubjectssubjectsCREATE TABLE subjects (
        subject_id INTEGER PRIMARY KEY AUTOINCREMENT,
        subject_code VARCHAR(30) UNIQUE NOT NULL,
        subject_name VARCHAR(120) NOT NULL,
        department VARCHAR(120) NOT NULL,
        semester INTEGER NOT NULL CHECK(semester BETWEEN 1 AND 8),
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    )/C indexsqlite_autoindex_subjects_1subjects       
